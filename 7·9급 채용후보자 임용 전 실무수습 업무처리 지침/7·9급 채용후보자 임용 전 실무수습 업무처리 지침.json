    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 예규는 공소청 소속 공무원 채용후보자의 임용 전 실무수습 등과 관련한 필요 사항을 정하여 공소청 소속 공무원으로서의 소양과 업무수행능력 배양과 수습기관의 실무수습 직원관리체계 마련을 그 목적으로 한다.",
        "enforcement_date": "",
