    "articles": [
      {
        "article_no": "제2조",
        "article_title": "시상대상 교육과정 및 수상자",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(시상대상 교육과정 및 수상자)교육상은 법무연수원(이하 ‘연수원’이라 한다)에서 실시하는 기본교육훈련과정 및 전문교육과정으로 평가가 실시되는 과정을 이수한 자중 성적이 우수한 자와  교육운영 유공자에게 수여한다. 다만, 우수분임에게도 수여할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(법무부)공무원교육상기금운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "시상 및 시상시기",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(시상 및 시상시기)①교육상은 연수원장이 해당 교육과정의 수료시에 시상하는 것을 원칙으로 하되 불가피한 경우 소속 기관의 장 또는 부서의 장으로 하여금 전수하게 할 수 있다.②제1항의 규정에 의한 시상의 규모 및 내용은 교육상운영위원회 심의를 거쳐 연수원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(법무부)공무원교육상기금운영규정#JO0003"
