    {
      "promulgation_date": "20180822",
      "promulgation_no": "2018-171",
      "content": "부칙 <제2018-171호,2018. 8. 22.>제1조(시행일) 이 고시는 발령한 날부터 시행한다.제2조(경과조치) 이 고시 제3장 레지던트 연차별 수련교과과정에 대해서는 시행 이후 최초로 수련을 개시하는 전공의 1년차부터 적용하고, 시행일 현재 전공의 과정 중에 있는 자에 대해서는 종전의 고시를 적용한다.",
      "provision_id": "admrul:치과의사전공의의연차별수련교과과정#ADDENDUM",
      "is_future": false,
      "source_mst": "2100000244670",
      "source_version_uid": "",
      "source_revision_type": "일부개정",
      "version_enforcement_date": "20240719"
    },
    {
      "promulgation_date": "20190807",
      "promulgation_no": "2019-179",
      "content": "부칙 <제2019-179호,2019. 8. 7.>제1조(시행일) 이 고시는 2019년 11월 8일부터 시행한다.제2조(적용례) 제1장 제2호의 개정규정은 이 고시 시행 이후 시작되는 외국의 의료기관 또는 수련기관의 인턴과정, 레지던트과정 또는 이에 준하는 과정을 받는 사람부터 적용한다.",
      "provision_id": "admrul:치과의사전공의의연차별수련교과과정#ADDENDUM",
      "is_future": false,
