  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별지",
      "title": "물품관리전환합의서",
      "enforcement_date": "",
      "content": "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃  〔별지 1호 서식〕                                                                                                                     ┃\n┃  물 품 관 리 전 환 합 의 서                                                                                                            ┃\n┃  ??????????????????????????????????????????????????????????????????  ┃\n┃┌──────────────────────────────────────────────────────────────────┐┃\n┃│① 관리전환을 하고자 하는 기관                                                                                                      │┃\n┃├──────┬───┬───────┬──────┬─────┬──────────────────────────────────┤┃\n┃│②중앙관서명│      │③소관기관명  │            │④회계명  │                                                                    │┃\n┃├──────┼───┼───┬───┼───┬──┼─────┼──────────────────────────────────┤┃\n┃│⑤물품분류  │⑥품명│⑦규격│⑧단위│⑨수량│금액│물품의상태│ 비고                                                               │┃\n┃│  번    호  │      │      │      │      │    │          │                                                                    │┃\n┃├──────┼───┼───┼───┼───┼──┼─────┼──────────────────────────────────┤┃\n┃│            │      │      │      │      │    │          │                                                                    │┃\n┃├──────┴───┼───┴───┴───┴──┴─────┴──────────────────────────────────┤┃\n┃│관리전환의조건      │                                                                                                              │┃\n┃├──────────┼───────────────────────────────────────────────────────┤┃\n┃│관리전환을필요로    │                                                                                                              │┃\n┃│    하는 사유       │                                                                                                              │┃\n┃├──────────┴───────────────────────────────────────────────────────┤┃\n┃│20   .   .   .                                                                                                                      │┃\n┃│                                                                                                                                    │┃\n┃│물품관리관의 직      성명        ??                                                                                               │┃\n┃├──────────────────────────────────────────────────────────────────┤┃\n┃│ 관리전환을 받고자 하는 기관                                                                                                        │┃\n┃├─────┬────────┬────────┬──┬────┬──────────────────────────────────┤┃\n┃│중앙관서명│                │소관기관명      │    │회계명  │                                                                    │┃\n┃├─────┴─┬──────┼────────┴──┴────┴──────────────────────────────────┤┃\n┃│관리전환받은후│물품의분류  │                                                                                                      │┃\n┃│              ├──────┼───────────────────────────────────────────────────┤┃\n┃│              │물품의용도  │                                                                                                      │┃\n┃├───────┴──────┴───────────────────────────────────────────────────┤┃\n┃│                                                                                                                                    │┃\n┃│                                                                                                                                    │┃\n┃│20   .   .   .                                                                                                                      │┃\n┃│                                                                                                                                    │┃\n┃│물품관리관의 직         성명       ??                                                                                             │┃\n┃└──────────────────────────────────────────────────────────────────┘┃\n┃  3306-42A  190㎜×268㎜                                                                                                                ┃\n┃  82.12.10 승인 (일반용지 70g/㎡)                                                                                                       ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
