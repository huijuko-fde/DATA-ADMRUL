      {
        "article_no": "제2조",
        "article_title": "검사의 책무",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(검사의 책무)검사는 영상녹화시 적법절차를 준수하고 영상녹화물을 엄격히 관리하여 자료유출 등으로 수사기밀이 누설되거나 그 진술내용이 영상녹화된 피의자 또는 피해자ㆍ목격자 등 사건 관계인(이하 \"참고인\"이라 한다)의 명예나 사생활의 비밀이 침해되지 않도록 유의하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:영상녹화업무처리지침#JO0002"
