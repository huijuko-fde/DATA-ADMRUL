      "content": "<수용ㆍ사용할 토지의 권리명세서 : 송악관리소>\n(당초)\n┌─┬─────┬────┬─┬───────┬────────────┬────────────────────┬──┐\n│번│소재지    │지 번   │지│지 적(㎡)     │토 지 소 유 자          │관 계 인                                │비고│\n│호│          │        │목├───┬───┼────┬───────┼─────┬────────┬─────┤    │\n│  │          │        │  │공부상│편입  │성 명   │주 소         │성 명     │주 소           │내 용     │    │\n│  │          │        │  │면적  │면적  │(명칭)  │              │(명칭)    │                │          │    │\n├─┼─────┼────┼─┼───┼───┼────┼───────┼─────┼────────┼─────┼──┤\n│1 │충청남도  │194-276 │전│4,087 │4,087 │박** 외 │경기도 평택시 │대호지농업│충청남도        │근저당권  │    │\n│  │당진시    │        │  │      │      │3인     │청북읍        │협동조합  │당진시 대호지면 │          │    │\n│  │송악읍    │        │  │      │      │        │안청로1길 75, │          │대호로 8        │          │    │\n│  │고대리    │        │  │      │      │        │102동 1501호  ├─────┼────────┼─────┤    │\n│  │          │        │  │      │      │        │(유승한내들아 │대호지농업│충청남도        │지상권    │    │\n│  │          │        │  │      │      │        │파트)         │협동조합  │당진시 대호지면 │          │    │\n│  │          │        │  │      │      │        │              │          │대호로 8        │          │    │\n├─┤          ├────┼─┼───┼───┼────┼───────┼─────┼────────┼─────┼──┤\n│2 │          │194-139 │답│872   │872   │남**    │경기도 평택시 │대호지농업│충청남도        │근저당권  │    │\n│  │          │3       │  │      │      │        │포승읍 여술로 │협동조합  │당진시 대호지면 │          │    │\n│  │          │        │  │      │      │        │74,           │          │대호로 8        │          │    │\n│  │          │        │  │      │      │        │104동 1102호  ├─────┼────────┼─────┤    │\n│  │          │        │  │      │      │        │(모아미래도아 │대호지농업│충청남도        │지상권    │    │\n│  │          │        │  │      │      │        │파트)         │협동조합  │당진시 대호지면 │          │    │\n│  │          │        │  │      │      │        │              │          │대호로 8        │          │    │\n├─┤          ├────┼─┼───┼───┼────┼───────┼─────┼────────┼─────┤    │\n│3 │          │194-138 │답│1,256 │1,256 │윤**    │수원시 영통구 │          │                │          │    │\n│  │          │7       │  │      │      │외 2인  │매탄동 1274   │          │                │          │    │\n│  │          │        │  │      │      │        │우남퍼스트빌  │          │                │          │    │\n│  │          │        │  │      │      │        │204-1303      │          │                │          │    │\n├─┤          ├────┼─┼───┼───┼────┼───────┼─────┼────────┼─────┼──┤\n│4 │          │194-137 │답│397   │397   │윤**    │수원시 영통구 │          │                │          │    │\n│  │          │4       │  │      │      │외 2인  │매탄동 1274   │          │                │          │    │\n│  │          │        │  │      │      │        │우남퍼스트빌  │          │                │          │    │\n│  │          │        │  │      │      │        │204-1303      │          │                │          │    │\n├─┴─────┼────┼─┼───┼───┼────┼───────┼─────┼────────┼─────┼──┤\n│합 계         │4필지   │  │6,612 │6,612 │        │              │          │                │          │    │\n└───────┴────┴─┴───┴───┴────┴───────┴─────┴────────┴─────┴──┘\n(변경)\n┌─┬─────┬────┬─┬───────┬──────────┬───────────┬──┐\n│번│소재지    │지 번   │지│지 적(㎡)     │토 지 소 유 자      │관 계 인              │비고│\n│호│          │        │목├───┬───┼───┬──────┼───┬───┬───┤    │\n│  │          │        │  │공부상│편입  │성 명 │주 소       │성 명 │주 소 │내 용 │    │\n│  │          │        │  │면적  │면적  │(명칭)│            │(명칭)│      │      │    │\n├─┼─────┼────┼─┼───┼───┼───┼──────┼───┼───┼───┼──┤\n│1 │충청남도  │194-276 │전│4,087 │4,087 │한국가│대구광역시  │      │      │      │    │\n│  │당진시    │        │  │      │      │스공사│동구 첨단로 │      │      │      │    │\n│  │송악읍    │        │  │      │      │      │120(신서동) │      │      │      │    │\n│  │고대리    │        │  │      │      │      │            │      │      │      │    │\n├─┼─────┼────┼─┼───┼───┼───┼──────┼───┼───┼───┼──┤\n│2 │충청남도  │194-139 │답│872   │872   │한국가│대구광역시  │      │      │      │    │\n│  │당진시    │3       │  │      │      │스공사│동구 첨단로 │      │      │      │    │\n│  │송악읍    │        │  │      │      │      │120(신서동) │      │      │      │    │\n│  │고대리    │        │  │      │      │      │            │      │      │      │    │\n├─┴─────┼────┼─┼───┼───┼───┼──────┼───┼───┼───┼──┤\n│합 계         │2필지   │  │4,959 │4,959 │      │            │      │      │      │    │\n└───────┴────┴─┴───┴───┴───┴──────┴───┴───┴───┴──┘",
