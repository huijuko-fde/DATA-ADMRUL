      {
        "article_no": "제6조",
        "article_title": "실무협의회",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(실무협의회) ① 협의회의 업무를 효율적으로 수행하기 위하여 실무협의회를 둘 수 있다.② 실무협의회의 구성ㆍ운영에 필요한 사항은 협의회의 의결을 거쳐 위원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:재정운용전략협의회운영규정#JO0006"
