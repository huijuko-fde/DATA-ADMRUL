  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별표",
      "title": "인가절차의 흐름",
      "enforcement_date": "",
      "content": "<별표 1> <개정 2008. 4. 7>\n인가절차의 흐름\n?????????\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃                                                        ┃\n┃┌─────┐┌────────┐                      ┃\n┃│신협중앙회││사전지도        │                      ┃\n┃│확     인 ││(신협중앙회)    │                      ┃\n┃│          │├────────┘                      ┃\n┃│          │  ↓                                      ┃\n┃│          │┌────────┐                      ┃\n┃│          ││신청서 접수     │                      ┃\n┃│          ││(신협중앙회)    │                      ┃\n┃│          │├────────┘  ┌────────┐┃\n┃│          │  ↓                ←│필요시 실지조사 │┃\n┃│          │                      │                │┃\n┃│          │┌────────┐  └────────┘┃\n┃├─────┤│의견 첨부,      │                      ┃\n┃            ││ 신청서 제출    │                      ┃\n┃            ││(대 금융위)     │                      ┃\n┃              └────────┘                      ┃\n┃                ↓                                      ┃\n┃┌─────┐┌────────┐                      ┃\n┃│심    사  ││신청사실 공고 및│                      ┃\n┃│단    계  ││의 견 수 렴     │                      ┃\n┃│          │└────────┘                      ┃\n┃│          │  ↓                                      ┃\n┃│          │┌────────┐                      ┃\n┃│          ││심   사         │                      ┃\n┃│          ││                │                      ┃\n┃│          ││                │                      ┃\n┃│          ││                │                      ┃\n┃│          ││                │                      ┃\n┃│          ││                │  ┌────────┐┃\n┃│          ││                │←│필 요 시        │┃\n┃│          ││                │  │평가위원회 구성 │┃\n┃│          ││                │  └────────┘┃\n┃│          ││                │                      ┃\n┃└─────┘└────────┘  ┌────────┐┃\n┃                ↓                ←│거부사실의 통보 │┃\n┃                                    │                │┃\n┃                                    │                │┃\n┃┌─────┐┌────────┐  └────────┘┃\n┃│인가단계  ││인   가         │                      ┃\n┃└─────┘└────────┘                      ┃\n┃                                                        ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
      "is_file_only": false,
