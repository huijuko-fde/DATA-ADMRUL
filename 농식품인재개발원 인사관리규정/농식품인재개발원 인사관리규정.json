    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 규정은 농식품인재개발원 소속공무원의 인사관리에 필요한 사항을 정함으로써 공정하고 효율적인 인사운용을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:농식품인재개발원인사관리규정#JO0001"
      },
      {
